# NVIDIA NIM — free tier, no credit card. Get a key at https://build.nvidia.com
# The catalog is OpenAI-compatible, so any other OpenAI-compatible endpoint
# (vLLM, Ollama, a local NIM container) works by changing LLM_BASE_URL alone.
#
# NIM's free-tier catalog lists far more models than a given key is actually
# entitled to invoke (listing and invoke-permission are different account
# states there) -- if LLM_MODEL below ever 404s with "Function ... not found
# for account", GET <LLM_BASE_URL>/models with your key to see what you can
# actually call, and try a few; see README.md's "If discovery can't reach a
# model" section.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=openai/gpt-oss-20b

# Agent loop stopping conditions. 1200s (not the more obvious 300s) because
# measured live against the NIM free tier, identical back-to-back calls to
# the same model ranged from ~2s to ~48s -- shared-queue load, not model
# choice or prompt size (both tested and ruled out as levers). See
# REPORT.md's Determinism & error handling section.
GRIP_MAX_STEPS=25
GRIP_RUN_TIMEOUT_S=1200

# Set to 0 to watch the browser — required for the escalation handoff demo,
# since a human has to be able to drive the session.
GRIP_HEADLESS=1

GRIP_POLICY=policy.yaml
